{
  "appId": "com.masjidazanclock.app",
  "appName": "Masjid Azan Clock",
  "webDir": "www",
  "bundledWebRuntime": false,
  "backgroundColor": "#040d06",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#040d06"
  },
  "plugins": {
